# Copy this file to .env and choose your own password.
# .env is ignored by git, so real values never end up on GitHub.

# Used by docker-compose.yml to create the Postgres user and database
POSTGRES_USER=inventory
POSTGRES_PASSWORD=change-me
POSTGRES_DB=inventory

# Used by database.py when you run the API on your machine (not in Docker).
# Must match the values above. Inside Docker Compose the app gets its own URL.
DATABASE_URL=postgresql+psycopg2://inventory:change-me@localhost:5432/inventory
